#!/usr/bin/env python3
"""Report Claude Code context usage.

  claude-context-probe                -> newest session, as one JSON object
  claude-context-probe --session ID   -> that session
  claude-context-probe --list         -> JSON array of recent sessions

Reads ONLY token counts, the session id, its title, the model id and the
working directory out of a transcript. No message text is ever parsed or
printed.
"""
import json, os, sys, glob, time

ROOT     = os.path.expanduser("~/.claude/projects")
JOBS     = os.path.expanduser("~/.claude/jobs")
TAIL     = 400_000       # bytes of transcript to scan back through
HEAD     = 64_000        # bytes to scan from the start
MAX_AGE  = 14 * 86400    # ignore sessions older than this in --list
MAX_LIST = 20


def transcripts():
    return glob.glob(os.path.join(ROOT, "*", "*.jsonl"))


def read_tail(path, nbytes):
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            size = fh.tell()
            fh.seek(max(0, size - nbytes))
            return fh.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return []


def read_head(path, nbytes):
    try:
        with open(path, "rb") as fh:
            return fh.read(nbytes).decode("utf-8", "ignore").splitlines()
    except OSError:
        return []


def scan(path, key, newest_first=True):
    """Return the most recent value of a top-level key, or ""."""
    needle = f'"{key}"'
    for lines in (read_tail(path, TAIL), read_head(path, HEAD)):
        for line in (reversed(lines) if newest_first else lines):
            if needle not in line:
                continue
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                val = json.loads(line).get(key)
            except ValueError:
                continue
            if isinstance(val, str) and val.strip():
                return val.strip()
    return ""


_JOB_NAMES = None


def job_names():
    """Map session id -> (name, source) for every named session.

    A session you rename in Claude Code is recorded outside the transcript, in
    ~/.claude/jobs/<id>/state.json. That directory is only the first eight
    characters of the id, so index by the ids stored inside the file instead --
    including resumeSessionId, since resuming starts a fresh transcript while
    the job keeps the name you gave it.
    """
    names = {}
    for p in glob.glob(os.path.join(JOBS, "*", "state.json")):
        try:
            with open(p) as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        custom = d.get("customTitle")
        if isinstance(custom, str) and custom.strip():
            entry = (custom.strip(), "user")
        else:
            n = d.get("name")
            if not (isinstance(n, str) and n.strip()):
                continue
            entry = (n.strip(), d.get("nameSource") or "")
        for key in ("sessionId", "resumeSessionId"):
            sid = d.get(key)
            if isinstance(sid, str) and sid:
                names[sid] = entry
    return names


def job_name(session_id):
    global _JOB_NAMES
    if _JOB_NAMES is None:
        _JOB_NAMES = job_names()
    return _JOB_NAMES.get(session_id, ("", ""))


def num(d, key):
    """Token counts, defensively. A transcript written by a newer or partly
    failed run can carry a null or a string here, and arithmetic on that
    crashed the whole reader."""
    v = d.get(key, 0)
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) else 0


def find_usage(node):
    """Walk a decoded JSON line; return (usage_dict, model_str) if present."""
    usage = model = None
    stack = [node]
    while stack:
        cur = stack.pop()
        if isinstance(cur, dict):
            u = cur.get("usage")
            if isinstance(u, dict) and "input_tokens" in u:
                usage = u
            m = cur.get("model")
            if isinstance(m, str) and m:
                model = m
            stack.extend(cur.values())
        elif isinstance(cur, list):
            stack.extend(cur)
    return usage, model


def settings_model():
    """Claude Code stores the selected model (e.g. "opus[1m]") in settings.json."""
    for p in ("~/.claude/settings.json", "~/.claude/settings.local.json"):
        try:
            with open(os.path.expanduser(p)) as fh:
                m = json.load(fh).get("model")
            if isinstance(m, str) and m:
                return m
        except (OSError, ValueError):
            continue
    return ""


def limit_for(model):
    env = os.environ.get("CLAUDE_CTX_LIMIT")
    if env and env.isdigit():
        return int(env)
    # The transcript records the bare id ("claude-opus-5"); only settings.json
    # keeps the "[1m]" suffix that distinguishes the 1M window from 200k.
    for m in (settings_model(), model or ""):
        if "[1m]" in m.lower():
            return 1_000_000
    return 200_000


def measure(path):
    """Context usage for one transcript."""
    out = {"id": os.path.splitext(os.path.basename(path or ""))[0],
           "path": path or "", "project": "", "title": "", "used": 0,
           "title_source": "", "limit": 200_000,
           "pct_used": 0.0, "pct_left": 100.0,
           "model": "", "age_s": -1, "ok": False}
    if not path or not os.path.exists(path):
        return out

    usage = model = None
    for line in reversed(read_tail(path, TAIL)):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            node = json.loads(line)
        except ValueError:
            continue
        u, m = find_usage(node)
        if u:
            usage, model = u, m
            break

    # "aiTitle" is the name Claude Code generates; a name you set yourself
    # lives in the job state instead and must win. "cwd" is on every entry,
    # though the opening records may be summaries without one.
    ai_title = scan(path, "aiTitle")
    name, source = job_name(out["id"])
    if name and (source == "user" or not ai_title):
        out["title"], out["title_source"] = name, source or "job"
    else:
        out["title"], out["title_source"] = ai_title, "ai" if ai_title else ""
    out["project"] = scan(path, "cwd")
    out["age_s"] = int(time.time() - os.path.getmtime(path))

    if usage:
        # The live context is the prompt of the last assistant turn: fresh
        # input plus everything replayed from cache. Its reply is excluded,
        # so this matches what /context reports.
        used = (num(usage, "input_tokens")
                + num(usage, "cache_read_input_tokens")
                + num(usage, "cache_creation_input_tokens"))
        lim = limit_for(model)
        if used > lim:            # session is on a bigger window than guessed
            lim = 1_000_000
        pct = 100.0 * used / lim
        out.update(used=used, limit=lim, pct_used=round(pct, 1),
                   pct_left=round(100.0 - pct, 1), model=model or "",
                   ok=used > 0)   # a zero total means malformed, not idle
    return out


def main():
    args = sys.argv[1:]

    if "--list" in args:
        now = time.time()
        recent = [p for p in transcripts()
                  if now - os.path.getmtime(p) < MAX_AGE]
        recent.sort(key=os.path.getmtime, reverse=True)
        # Sessions that never produced a turn carry no usage and no cwd; they
        # are noise in a picker.
        rows = [m for m in (measure(p) for p in recent) if m["ok"]]
        print(json.dumps(rows[:MAX_LIST]))
        return

    path = None
    if "--session" in args:
        i = args.index("--session") + 1
        if i >= len(args) or not args[i].strip():
            sys.exit("claude-context-probe: --session needs a session id")
        sid = args[i]
        for p in transcripts():
            if os.path.splitext(os.path.basename(p))[0] == sid:
                path = p
                break
    else:
        files = transcripts()
        path = max(files, key=os.path.getmtime) if files else None

    print(json.dumps(measure(path)))


if __name__ == "__main__":
    main()
